{
  "name": "gadmo",
  "private": true,
  "description": "GADMO \u2014 The Right Skills. Within Reach.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:env": "node scripts/setup-env.mjs",
    "setup:local": "node scripts/setup-env.mjs && pnpm --filter @gadmo/shared build && pnpm --filter @gadmo/api db:migrate && pnpm --filter @gadmo/api db:seed",
    "dev:api": "pnpm --filter @gadmo/api dev",
    "demo": "pnpm --filter @gadmo/shared build && pnpm --filter @gadmo/api demo",
    "dev:web": "pnpm --filter @gadmo/shared build && pnpm --filter @gadmo/web dev",
    "pro:approve": "pnpm --filter @gadmo/shared build && pnpm --filter @gadmo/api pro:approve"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
