# Copy to .env for local development. NEVER commit real values.
# In production, set these as secrets in your host / GitHub Actions secrets.

NODE_ENV=development
PORT=4000

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://gadmo:gadmo_local_only@localhost:5432/gadmo?schema=public

# Redis (OTP rate limits, queues)
REDIS_URL=redis://localhost:6379

# Auth — generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
OTP_PEPPER=

# Web app origin allowed by CORS (the PWA)
WEB_ORIGIN=http://localhost:3000

# SMS provider (e.g. Termii). In development, OTPs are logged to the console instead.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=GADMO
# Development only: a fixed 6-digit code that always signs in (e.g. 123456). Use it if
# printed codes are refused because your computer's clock jumps (WSL/Docker). Leave empty otherwise.
DEV_LOGIN_CODE=

# Payments. "test" = GADMO's own test checkout (no money moves; refused in production).
# "paystack" = real Paystack checkout: use a TEST secret key (sk_test_...) until launch.
PAYMENT_PROVIDER=test
PAYSTACK_SECRET_KEY=

# Identity verification (KYC) provider — to be chosen
KYC_PROVIDER=
KYC_API_KEY=

# Field-level encryption key for NIN / bank details (32 bytes, base64)
FIELD_ENCRYPTION_KEY=

# Monitoring
SENTRY_DSN=

# Web push alerts. Generate with: npx web-push generate-vapid-keys
# Leave empty in development: GADMO makes a pair once and keeps it in apps/api/.vapid.dev.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# In-app calls. STUN is free (Google's public servers by default). Add a TURN server
# (e.g. from Metered or Cloudflare) so calls also connect on strict mobile networks.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
